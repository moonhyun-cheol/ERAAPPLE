{
  "name": "era-web-engine-probe",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "build:pwa": "node build.mjs && node build-pwa.mjs",
    "verify:release": "node verify-release.mjs",
    "test:release": "node release-regression.mjs",
    "serve:pwa": "node serve-pwa.mjs",
    "test:pwa": "node --test --test-timeout=180000 pwa-test.mjs",
    "test:pwa-game": "node --test --test-timeout=180000 pwa-game-test.mjs",
    "test:mobile-wait": "node --test --test-timeout=180000 mobile-wait-test.mjs",
    "test:backup": "node --test --test-timeout=90000 backup-test.mjs",
    "test:server": "node --test serve-pwa-test.mjs",
    "test": "node --test --test-timeout=30000 test.mjs input-gate-test.mjs",
    "test:runtime": "node --test --test-timeout=90000 input-gate-test.mjs runtime-browser-test.mjs",
    "test:render": "node --test --test-timeout=180000 render-performance-test.mjs",
    "test:save-memory": "node --test --test-timeout=180000 compact-save-test.mjs runtime-trace-test.mjs",
    "test:m1-harness": "node --test m1-harness-test.mjs vm-structure-test.mjs compact-function-ir-test.mjs paged-default-array-test.mjs lazy-static-scope-test.mjs",
    "test:paged": "node --test --test-timeout=60000 paged-default-array-test.mjs",
    "profile:paged": "node --expose-gc paged-default-array-profile.mjs",
    "profile:paged-direct": "node paged-direct-access-profile.mjs",
    "profile:paged-browser": "node paged-default-array-browser-profile.mjs",
    "profile:m1": "node --expose-gc m1-baseline.mjs",
    "profile:m1-ownership": "node --expose-gc m1-ownership-profile.mjs",
    "profile:transition-peak": "node --expose-gc transition-peak-profile.mjs",
    "profile:compact-ir": "node --expose-gc compact-function-ir-profile.mjs",
    "profile:compact-statements": "node --expose-gc compact-statement-vector-profile.mjs",
    "profile:statement-payloads": "node --expose-gc statement-payload-profile.mjs",
    "profile:compact-printform": "node --expose-gc compact-printform-payload-profile.mjs",
    "profile:lazy-static": "node --expose-gc lazy-static-scope-profile.mjs",
    "profile:compact-assign": "node --expose-gc compact-assign-payload-profile.mjs",
    "verify:compact-statements": "node compact-statement-vector-acceptance.mjs --run",
    "verify:compact-printform": "node compact-printform-payload-acceptance.mjs --run",
    "verify:lazy-static": "node lazy-static-scope-acceptance.mjs --run",
    "verify:compact-assign": "node compact-assign-payload-acceptance.mjs --run",
    "test:save-profile": "node --expose-gc save-memory-profile.mjs",
    "test:deferred-local": "node --test deferred-local-test.mjs && node --expose-gc deferred-local-profile.mjs",
    "test:days": "node --test --test-timeout=260000 day-browser-test.mjs",
    "test:browser": "node --test --test-timeout=60000 browser-test.mjs",
    "test:game-browser": "node --test --test-timeout=120000 game-browser-test.mjs",
    "probe": "node probe.mjs",
    "serve": "node serve.mjs"
  },
  "devDependencies": {
    "dayjs": "1.11.13",
    "esbuild": "0.25.9",
    "papaparse": "5.5.3",
    "parsimmon": "1.18.1",
    "playwright": "1.55.1"
  }
}
