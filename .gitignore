# === era runtime: save / log / debug ===
[Ss]av/
global.sav
save[0-9]+.sav
emuera.log
[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]-[0-9]*.log
logs/
debug/
*.pid

# === Local upstream checkout used by development probes ===
.my_agent_remote/

# === Agent internal checkpoints (not project content) ===
.cqr-pa/

# === Third-party binaries & archives (not tracked: redistributable/regenerable) ===
*.exe
*.7z

# === Transient probe run artifacts (logs only; keep .json result snapshots) ===
tools/web-engine-probe/*.log
tools/web-engine-probe/results/*.log

# === Server-authoritative runtime: secrets & runtime state (NEVER commit) ===
# See docs/web-runtime/server-runtime-plan.md §10–§11. main is the public Pages
# deploy line, so server secrets/state must never be tracked.
.env
.env.*
!.env.example
server-config/
server-data/
server/**/*.log
server/logs/
