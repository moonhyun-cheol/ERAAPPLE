# era server-authoritative runtime — environment template
# Copy to `.env` (kept out of git by .gitignore) and edit. Every value is optional; the defaults
# below are the code defaults from server/config.mjs. Moving the server to another PC is a folder
# copy + editing this file — never a code edit (plan §8 portability).
#
#   cp .env.example .env      # then edit, then:  node server/run.mjs
#
# NOTE: this repo has no dotenv loader. Either export these in your shell / Scheduled Task, or the
# autostart script (server/scripts/register-autostart.ps1) reads this .env and passes the values in.

# --- network binding -----------------------------------------------------------------------------
# 127.0.0.1 = local only (safe default; a tunnel like Tailscale/Cloudflare reaches it without a
# public bind). Set 0.0.0.0 ONLY if you intentionally expose the port on your LAN/router — and then
# ERA_SERVER_TOKEN below becomes mandatory.
ERA_SERVER_HOST=127.0.0.1
ERA_SERVER_PORT=8787

# --- single-user access token (plan §4/§7) ------------------------------------------------------
# Empty = no gate (fine for pure localhost). REQUIRED once the server is reachable off-box.
# Generate one:  node -e "console.log(require('crypto').randomUUID())"
# The phone then connects with it in the URL:  https://<your-host>/?token=<this-value>
ERA_SERVER_TOKEN=

# --- state locations (plan §8-1: all state under one relocatable place) --------------------------
# Defaults sit beside the repo. Point ERA_SERVER_ROOT at an external folder (e.g. a synced drive)
# to relocate saves + config together, or override each dir individually.
#ERA_SERVER_ROOT=
#ERA_SERVER_DATA_DIR=server-data
#ERA_SERVER_CONFIG_DIR=server-config

# --- game source ---------------------------------------------------------------------------------
# Default is the tracked '에라마왕 개조판 1.28' folder beside the repo root. Override if the game
# lives elsewhere. If absent, the host boots on the neutral fixture so the client is still testable.
#ERA_SERVER_GAME_DIR=

# --- supervisor tunables (server/run.mjs; plan §9 always-on) -------------------------------------
#ERA_SUPERVISOR_BACKOFF_MS=1000
#ERA_SUPERVISOR_MAX_BACKOFF_MS=30000
#ERA_SUPERVISOR_HEALTHY_MS=10000
#ERA_SUPERVISOR_MAX_FAST_FAILS=8
