@NTR_VIDEO
;-----------------------------------------
;광왕님의 메세지를 읽어주세요
;캐릭터 설정은 TARGET

;TARGET확인
SIF TARGET < 0 && TARGET > CHARANUM
	RETURN 0
;NTR확인
SIF CFLAG:1 != 9
	RETURN 0

PRINTL  

;랜덤으로 NTR상태가 해제되어 침공해옴
;妊娠中は侵攻しない
IF RAND:6 == 0 && TALENT:153 == 0
	PRINTFORML 광왕은 %SAVESTR:TARGET%에게 마왕을 봉인하도록 명령했다
	PRINTFORMW %조사선택(SAVESTR:TARGET, "는")% 던전으로 여행을 떠났습니다
	CFLAG:1 = 2
	
	;침입 계층・침공도・침공 중・재기 포인트 설정
	CFLAG:501 = 1
	CFLAG:502 = 0
	CFLAG:1 = 2
	CFLAG:508 = 3
	;카르마가 얼마정도 회복
	SIF CFLAG:151 < -50
		CFLAG:151 = -50
	;호감도가 낮음
	CFLAG:2 = 20
	
	RETURN 0
ENDIF

CALL NTR_PLAY

;구슬에 따라서는 소질이 성장할 가능성이 있음

;Ｖ감각의 구슬에 의한 여부（I=0:可、I&1:구슬 부족、I&2:경험 부족）
I = 0
CALL DECIDE_ABLUP2
IF I == 0 && RESULT == 1 && ABL:2 < 10
	ABL:2 += 1
	JUEL:1 -= A
	PRINTFORML %ABLNAME:2%의 레벨이 {ABL:2}가 되었습니다
ENDIF

;Ａ감각의 구슬에 의한 여부（I=0:可、I&1:구슬 부족、I&2:경험 부족）
I = 0
CALL DECIDE_ABLUP3
IF I == 0 && RESULT == 1 && ABL:3 < 10
	ABL:3 += 1
	JUEL:2 -= A
	PRINTFORML %ABLNAME:3%의 레벨이 {ABL:3}이 되었습니다
ENDIF

;욕정의 구슬에 의한 여부（I=0:可、I&1:구슬 부족、I&2:경험 부족）
I = 0
;이상경험이 필요한가
E = 0
CALL DECIDE_ABLUP11
IF I == 0 && RESULT == 1 && ABL:11 < 10
	ABL:11 += 1
	JUEL:5 -= A
	PRINTFORML %ABLNAME:11%의 레벨이 {ABL:11}이 되었습니다
ENDIF

RETURN 0


;------------------------------------------
@NTR_PLAY
;------------------------------------------
;플레이 내용은 P지정。구상용으로
;형식은 비디오 편지。수정공으로 보내옴

SIF GETBIT(FLAG:8,5)
	CALL KARMA, TARGET, 10

PRINTW 광왕이 수정구를 하나 보내왔다.
EXP:피사경험 += 1
PRINTFORM 수정구에는 
IF TALENT:TARGET:임신
	IF CFLAG:TARGET:102 == 1
		PRINTFORM 마왕의 아이를 임신한 
	ELSEIF CFLAG:TARGET:102 == 5
		PRINTFORM 개의 아이를 임신한 
	ELSEIF CFLAG:TARGET:102 == 7
		PRINTFORM 광왕의 아이를 임신한 
	ELSEIF CFLAG:TARGET:1 == 9
		PRINTFORM 모르는 남자의 아이를 임신한 
	ELSE
		PRINTFORM ???의 아이를 임신한 
	ENDIF
ELSE
	PRINT
ENDIF
IF TALENT:TARGET:임신 && CFLAG:TARGET:110 - 3 <= DAY
	PRINT 만삭의 
ELSE
	PRINT 
ENDIF
PRINTFORM %조사처리(SAVESTR:TARGET,"가")% 

IF ((ABL:욕망 + ABL:순종 >= 22) || RAND:(22 - (ABL:욕망 + ABL:순종)) == 0) && TALENT:남자 == 0 && TALENT:광왕의포로 == 0
	CALL ARREST_EVENT_1
ELSE
	CALL ARREST_EVENT_2
ENDIF

RETURN 0

