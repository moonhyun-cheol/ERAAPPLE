	CFLAG:A:881 = 0
	CFLAG:A:882 = 0
	CFLAG:A:883 = 0
	CFLAG:A:884 = 0
	CFLAG:A:885 = 0
	
	;ABCのループが終わり, D:4の試行回数が残っているなら
	;またAから罠を回していく
	
	
	
NEXT

