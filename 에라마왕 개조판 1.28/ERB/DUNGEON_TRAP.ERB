@SUMMON_TRAP
#DIM AVOID_MAGIC
#DIM AVOID_NEGATIVE
#DIM AVOID_POSITIVE
#DIM AVOID_RACE
#DIM PERCENT_AVOID
#DIM PERCENT_TRAP
;------------------------------
;소환형함정

PERCENT_AVOID = AVOID_MAGIC + AVOID_POSITIVE + AVOID_RACE + CFLAG:A:9
PERCENT_TRAP = (100 * (((MAXBASE:A:0 + MAXBASE:A:1)-(BASE:A:0 + BASE:A:1))/(MAXBASE:A:0 + MAXBASE:A:1))) + FLAG:85

IF FLAG:5 & 32 || CFLAG:(A):700
	IF CFLAG:A:860 > 0
		PRINTL 위로 올라갈 방법을 찾던 도중, 발 밑에서 이상한 마법진이 발동하였다!
	ELSE
		;CFLAG:859 == 1 상점, 2 늪지대, 3 인간목장, 4 얼음방, 5 달군모래, 6 미궁, 7 박물관, 8 창관거리, ELSE 통로
		IF CFLAG:A:859 == 1 
			PRINTL 상점가를 벗어나는 길목에 접어들자, 숨겨져 있던 마법진이 발동되었다!
		ELSEIF CFLAG:A:859 == 2
			PRINTL 늪지대의 단단한 곳에 발을 올리자, 그 위에 있던 마법진이 발동되었다!
		ELSEIF CFLAG:A:859 == 3
			PRINTL 용사를 풀어주기 위해 가까이 다가가자, 마법진이 발동되었다!
		ELSEIF CFLAG:A:859 == 4
			PRINTL 눈에 가려져있던 마법진이 발동되었다!
		ELSEIF CFLAG:A:859 == 5
			PRINTL 모래 밑에 숨겨진 마법진이 발동되었다!
		ELSEIF CFLAG:A:859 == 6
			PRINTL 길을 찾던 용사의 발 밑에서 어떤 마법진이 발동되었다!
		ELSEIF CFLAG:A:859 == 7
			PRINTL 슬퍼하는 여인의 그림에 가까이 다가갔다가 어떤 마법진이 발동되었다!
		ELSEIF CFLAG:A:859 == 8
			PRINTL 창녀에게서 벗어나다가 어떤 마법진이 발동되었다!
		ELSE
			PRINTL 걷다가 발 밑에서 이상한 마법진이 발동하였다!
		ENDIF
	ENDIF
ENDIF

IF LIMIT(PERCENT_AVOID - PERCENT_TRAP, 10, 60) > RAND:100
	IF FLAG:5 & 32 || CFLAG:(A):700 
		CALL TRAP_WORM
		IF TALENT:A:도적 || TALENT:A:닌자 || TALENT:A:궁수 
			PRINTFORML 소환진이란 것을 알아차린 %조사선택(SAVESTR:A, "는")% 바로 소환진 일부를 파괴하여 소환진을 무력화했다… 
		ELSEIF TALENT:A:마술사
			IF BASE:A:1 >= 10
				PRINTFORML %조사선택(SAVESTR:A, "는")% 재빨리 소환진을 디스펠하였다… 
			ELSE
				PRINTFORML %조사선택(SAVESTR:A, "는")% 없는 마력으로 부분적으로 마법진을 파괴하여 소환진을 무력화했다… 
			ENDIF
		ELSEIF TALENT:A:전사 || TALENT:A:기사 || TALENT:A:마계장군 
			PRINTFORML 소환진이란 것을 알아차린 %조사선택(SAVESTR:A, "는")% 소환진에 무기를 계속 휘둘러 발동하기 전에 멈추는데 성공하였다… 
		ELSEIF TALENT:A:신관 || TALENT:A:무녀 || TALENT:A:마도신관 
			PRINTFORML %조사선택(SAVESTR:A, "는")% 마계의 틈을 일시적으로 막는 주문을 외워 소환진을 무력화했다… 
		ELSE
			PRINTFORML %조사선택(SAVESTR:A, "는")% 무기를 마구잡이로 휘둘러 소환진을 망가트렸다… 
		ENDIF
	ENDIF
	
	;캐스팅에 의한 기력 사용
	IF TALENT:A:신관 || TALENT:A:무녀 || TALENT:A:마도신관 || TALENT:A:마술사
		BASE:A:1 -= 10
	ENDIF
ELSE
	IF FLAG:5 & 32 || CFLAG:(A):700 
		IF TALENT:A:도적 || TALENT:A:닌자 || TALENT:A:궁수 
			PRINTFORML 소환진이란 것을 알아차린 %조사선택(SAVESTR:A, "는")% 곧 나올 몬스터들에게 들키지 않도록 몸을 숨겼다… 
		ELSEIF TALENT:A:마술사
			PRINTFORML %조사선택(SAVESTR:A, "는")% 파훼할 시간이 부족하자 몬스터들이 지나갈 때 까지 몸을 숨겼다… 
		ELSEIF TALENT:A:전사 || TALENT:A:기사 || TALENT:A:마계장군 
			PRINTFORML %조사선택(SAVESTR:A, "는")% 무기를 휘두르다가 소환진에서 빛이 나오는 것을 보고 몬스터들의 눈에 띄지 않도록 몸을 숨겼다… 
		ELSEIF TALENT:A:신관 || TALENT:A:무녀 || TALENT:A:마도신관 
			PRINTFORML 주문을 외울 시간이 없는걸 안 %조사선택(SAVESTR:A, "는")% 몬스터들의 눈에 띄지 않도록 몸을 숨겼다… 
		ELSE
			PRINTFORML %조사선택(SAVESTR:A, "는")% 몬스터들의 눈에 띄지 않도록 몸을 숨겼다… 
		ENDIF
	ENDIF
	
	CALL SUMMON_MONSTER, -1
ENDIF

RETURN 0


