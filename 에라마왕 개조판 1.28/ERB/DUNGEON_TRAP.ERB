;------------------------------
@DARK_JUEL_TRAP
#DIM DICE
;------------------------------
;보석의함정

SIF FLAG:5 & 32|| CFLAG:(A):700 
	PRINTFORML %SAVESTR:A%는 비싼 보석을 줍게 되었다……

DICE = RAND:5 * 50

;カルマが高いと誘惑に打ち勝つ判定
SIF CFLAG:A:151 > 150 && RAND:4 == 0
	DICE = 0

IF DICE == 0
	SIF FLAG:5 & 32|| CFLAG:(A):700 
		PRINTL 용사는 유혹을 이긴 것 같다
	RETURN 1
ENDIF

DICE += FLAG:85 * 10
DICE = DICE * (99 + POWER(CFLAG:A:501, 3)) / 100

;好奇心ボーナス
SIF TALENT:A:호기심
	DICE += 5
;金のためボーナス
SIF TALENT:A:용사가된동기 == 2
	DICE += 10
;ホビットボーナス
SIF TALENT:A:종족 == 10
	DICE += 15
;ドワーフボーナス
SIF TALENT:A:종족 == 11
	DICE += 15
;盗賊は収入が多い（1.2倍）
SIF TALENT:A:도적
	DICE += DICE / 5

SIF FLAG:5 & 32|| CFLAG:(A):700 
	PRINTFORML 총 {DICE}개의 가치가 있는 보석이 용사의 호주머니 속으로 들어갔다……

CFLAG:A:581 += DICE

JUEL:A:6 += 5
SIF FLAG:5 & 32|| CFLAG:(A):700 
	PRINTFORML 굴복의 구슬+5

;そしてカルマが下がる
CALL KARMA, A, -1

RETURN 0

