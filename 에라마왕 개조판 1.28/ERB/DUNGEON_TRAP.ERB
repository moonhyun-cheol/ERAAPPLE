#DIM AVOID_RACE
#DIM PERCENT_AVOID
#DIM PERCENT_TRAP
;------------------------------
;기름단지형함정

PERCENT_AVOID = AVOID_JOP + AVOID_POSITIVE + AVOID_RACE + CFLAG:A:9
PERCENT_TRAP = (100 * (((MAXBASE:A:0 + MAXBASE:A:1)-(BASE:A:0 + BASE:A:1))/(MAXBASE:A:0 + MAXBASE:A:1))) + FLAG:85

IF FLAG:5 & 32 || CFLAG:(A):700
	IF CFLAG:A:513 == 72
		PRINT 방금 거둬낸 거미줄과 연결되어 있던 장치의 기믹을 건드려 기름단지가 떨어졌다! 
	ELSEIF CFLAG:A:860 > 0
		PRINT 위로 올라갈 방법을 찾던 도중
			IF RAND:3 == 0
				PRINTL , 위로 올라가는 밧줄을 발견하고 잡아 당기자 기름단지가 떨어졌다! 
			ELSEIF RAND:2 == 0
				PRINTL , 발 밑의 실이 끊어지며 기름이 뿜어져 나왔다! 
			ELSE
				PRINTL 에 벽의 틈새에서 기름이 뿜어져 나왔다! 
			ENDIF
	ELSE
		;CFLAG:859 == 1 상점, 2 늪지대, 3 인간목장, 4 얼음방, 5 달군모래, 6 미궁, 7 박물관, 8 창관거리, ELSE 통로
		IF CFLAG:A:859 == 1 
			PRINTL 상점가를 걸어가던 도중, 갑자기 휙 소리가 나며 기름단지가 떨어졌다! 
		ELSEIF CFLAG:A:859 == 2
			PRINTL 늪지대의 덩쿨을 치우던 도중, 위에서 기름단지가 떨어졌다! 
		ELSEIF CFLAG:A:859 == 3
			PRINTL 용사를 풀어주기 위해 자물쇠에 손대는 순간, 위쪽에서 기름단지가 떨어졌다! 
		ELSEIF CFLAG:A:859 == 4
			PRINTL 눈보라 때문에 밑을 보지 못하던 때 밑에서 기름이 뿜어져 나왔다! 
		ELSEIF CFLAG:A:859 == 5
			PRINTL 모래 바람 때문에 밑을 보지 못하던 때 위에서 기름단지가 떨어졌다! 
		ELSEIF CFLAG:A:859 == 6
			PRINTL 벽을 짚고 걷다가 뭔가 잘못 눌러 위에서 기름단지가 떨어졌다! 
		ELSEIF CFLAG:A:859 == 7
			PRINTL 마치 소리지르는 듯한 석상에 손을 댔더니 입에서 기름이 뿜어져 나왔다! 
		ELSEIF CFLAG:A:859 == 8
			PRINTL 창녀 중 하나가 뒤돌아서 걸어가는 용사 방향에 있는 기름단지 함정을 발동시켰다!
		ELSE
			PRINTL 걷다가 뭔가 잘못 밟자 위에서 기름단지가 떨어졌다! 
		ENDIF
	ENDIF
ENDIF

IF CFLAG:A:513 == 72
	CALL OIL_TRAP_SUCCESS
ELSEIF LIMIT(PERCENT_AVOID - PERCENT_TRAP, 10, 50) > RAND:100
	CALL OIL_TRAP_FAIL
ELSE
	CALL OIL_TRAP_SUCCESS
ENDIF

RETURN 0


