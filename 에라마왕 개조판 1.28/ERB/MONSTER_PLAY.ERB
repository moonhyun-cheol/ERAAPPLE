;몬스터들과 노닥노닥
;とりあえずやっつけ。수정 패치도 환영

;-----------------------------------
@MONSTER_PLAY
;-----------------------------------
$INPUT_LOOP

CALL MONSTERPLAY_LIST

SIF ITEM:22 >= 1
	PRINT [900] 똥개 
PRINTL [999] 돌아간다

INPUT

IF RESULT == 999
	RETURN 0
ELSEIF ITEM:RESULT <= 0 && RESULT != 900
	GOTO INPUT_LOOP
ELSEIF RESULT == 900 && ITEM:22 <= 0
	GOTO INPUT_LOOP
ENDIF

LOCAL:0 = RESULT
IF LOCAL:0 != 900
	CALL MONSTER_DATA, LOCAL:0, 5
	LOCAL:1 = E:507
ENDIF

A = 0
Y = RAND:5 + 3

IF LOCAL:0 == 900
	CALL MONSTER_PLAY_DOG
ELSEIF LOCAL:1 == 1
	CALL ORC_MONSTER_PLAY
ELSEIF LOCAL:1 == 2
	CALL SLIME_MONSTER_PLAY
ELSEIF LOCAL:1 == 3
	CALL INSECT_MONSTER_PLAY
ELSEIF LOCAL:1 == 4
	CALL IVY_MONSTER_PLAY
ELSEIF LOCAL:1 == 5
	CALL SYOKUSYU_MONSTER_PLAY
ELSEIF LOCAL:1 == 6
	CALL FAILY_MONSTER_PLAY
ELSEIF LOCAL:1 == 7
	CALL GIANT_MONSTER_PLAY
ELSEIF LOCAL:1 == 8
	CALL MAN_MONSTER_PLAY
ELSEIF LOCAL:1 == 9
	CALL GIRL_MONSTER_PLAY
ELSEIF LOCAL:1 == 10
	CALL BEAST_MONSTER_PLAY
ELSEIF LOCAL:1 == 11
	CALL BRAIN_MONSTER_PLAY
ELSEIF LOCAL:1 == 12
	CALL HORSE_MONSTER_PLAY
ENDIF

IF TALENT:A:0 == 1 && EXP:A:0 > 0
	PRINTW 【처녀상실】
	TALENT:A:0 = 0
ENDIF



BEGIN TURNEND
RETURN 1

;-------------------------------------
@MONSTERPLAY_LIST
;-------------------------------------

PRINTL 몬스터를 선택하십시오

LOCAL:1 = 0
FOR LOCAL:0, 100, 200
	IF ITEM:(LOCAL:0) >= 1
		PRINTFORM [{LOCAL:0}] %ITEMNAME:(LOCAL:0)%　　
		LOCAL:1 += 1
	ENDIF
	
	IF LOCAL:1 >= 3
		PRINTL  
		LOCAL:1 = 0
	ENDIF
NEXT

SIF LOCAL:1 != 0
	PRINTL  

RETURN 0

;-----------------------------------------
@MONSTER_PLAY_DOG
;-----------------------------------------

IF TALENT:A:122 == 1
	PRINTW 당신은 개에게 간식을 주었다
ELSE
	IF EXP:A:수간경험 > 10000
		PRINTFORML 수간경험 10000 이상
	ELSEIF EXP:A:수간경험 > 1000
		PRINTFORML 용사를 망가트리기 위해 산 똥개에게 도리어 자신이 빠져버린 것을 느낀 마왕은 
		PRINTFORML 이제 부르지 않으려고 했으나 욱씬거리는 몸을 참지 못하고 결국 불러버렸다. 
		PRINTFORML 발기된 개의 자지를 본 마왕은 자동적으로 엎드려서 자지를 받아드릴 준비를 했고, 
		PRINTFORML 발정난 암캐의 냄새에 참지 않고 허리를 놀리자 마왕은 몰아치는 쾌락에 정신을 차리지 못하고 있었다.
		PRINTFORML 마치 임신을 원하는 듯이 달라붙는 보지에 자궁구에 고정하여 질내사정 하자 
		PRINTFORML 자궁은 단 한 방울도 놓치지 않겠다는 듯이 정액을 받아들였다.
	ELSEIF EXP:A:수간경험 > 100
		PRINTFORML 똥개가 끼잉거리며 자신을 바라보자, 뭘 원하는지 알아차리고 엎드리고 엉덩이를 들어올렸다.
		PRINTFORML 스스로 심심풀이라고 자위하고 있었지만 이미 야한 냄새를 풀풀 풍기며 내민 비부를 본 똥개는 
		PRINTFORML 눈 앞에 있는 마왕을 주인이 아닌 암캐로 인식하고 임신시키기 위한 진심 교미를 시작했다.
			IF TALENT:A:임신
				IF CFLAG:A:110 - 3 <= DAY
					PRINT 이미 아이를 임신하여 부풀어 오른 배에도 불구하고 자궁구를 부술듯이 찌르는 
				ELSE
					PRINT 임신한 아이를 신경쓰지 않고 내장이 짜부라질듯이 찌르는 
				ENDIF
			ELSE
				PRINT 어떻게든 수정시키겠다는 의지를 보여주는 듯이 자궁구를 계속 두드리는 
			ENDIF
		PRINTFORML 자지에 
		PRINTFORML 정신을 차릴 수 없었던 마왕은 자신도 모르게 허리를 흔들며 똥개의 움직임에 맞춰나갔고, 
		PRINTFORML 자궁에 쏟아지는 정액의 열기를 이기지 못하고 성대하게 가버리고 말았다.
	ELSEIF EXP:A:수간경험 > 10
		PRINTFORML 수간경험 10 이상
	ELSEIF EXP:A:수간경험 > 0
		PRINTFORML 수간경험 1 이상
	ELSE
		EXP:A:이상경험 += 1
		PRINTL 『끄ー응、끄으ー응』
		SIF TALENT:A:동물귀
			PRINT 동물귀를 달고 있어서인지
		PRINTFORML 용사를 능욕하기 위해 산 똥개가 부풀어오른 음경을 내밀자
		PRINTFORML 한 번쯤은 이런 짓을 해도 괜찮지 않을까 라고 생각하며 다리를 벌리고 비부에 꽂아넣도록 유도하였다.
			IF ABL:A:Ｖ감각 || ABL:A:욕망 || ABL:A:성교중독 || ABL:A:수간중독 > 0
				PRINTFORML 개의 자지도 생각보다 괜찮다고 생각하며 자궁을 채우는 정액의 느낌에 가볍게 가버렸다.
			ELSE
				PRINTFORML 쌓여있었던 것인지, 개는 몇번 찌르지도 못하고 그냥 싸버렸다.
			ENDIF
	ENDIF
	
	
	PRINTL 
	PRINTFORML Ｖ경험+{(((TALENT:A:동물귀 + TALENT:A:암캐)+1)*(ABL:A:Ｖ감각 + ABL:A:욕망 + ABL:A:순종 + ABL:A:성교중독 + ABL:A:정액중독 + ABL:A:수간중독 + (RAND:5)))}
	EXP:A:0 += (((TALENT:A:동물귀 + TALENT:A:암캐)+1)*(ABL:A:Ｖ감각 + ABL:A:욕망 + ABL:A:순종 + ABL:A:성교중독 + ABL:A:정액중독 + ABL:A:수간중독 + (RAND:5)))
		IF ABL:A:Ｖ감각 || ABL:A:욕망 || ABL:A:성교중독 || ABL:A:수간중독 > 0
			PRINTFORML 절정경험+{(((TALENT:A:동물귀 + TALENT:A:암캐)+1)*(ABL:A:Ｖ감각 + ABL:A:욕망 + ABL:A:성교중독 + ABL:A:정액중독 + ABL:A:수간중독))}
			EXP:A:2 += (((TALENT:A:동물귀 + TALENT:A:암캐)+1)*(ABL:A:Ｖ감각 + ABL:A:욕망 + ABL:A:성교중독 + ABL:A:정액중독 + ABL:A:수간중독))
		ENDIF
	PRINTFORML 성교경험+{(((TALENT:A:동물귀 + TALENT:A:암캐)+1)*(ABL:A:Ｖ감각 + ABL:A:욕망 + ABL:A:순종 + ABL:A:성교중독 + ABL:A:정액중독 + ABL:A:수간중독 + (RAND:5)))}
	EXP:A:5 += (((TALENT:A:동물귀 + TALENT:A:암캐)+1)*(ABL:A:Ｖ감각 + ABL:A:욕망 + ABL:A:순종 + ABL:A:성교중독 + ABL:A:정액중독 + ABL:A:수간중독 + (RAND:5)))
	PRINTFORML 정액경험+{(((TALENT:A:동물귀 + TALENT:A:암캐)+1)*(ABL:A:Ｖ감각 + ABL:A:욕망 + ABL:A:순종 + ABL:A:성교중독 + ABL:A:정액중독 + ABL:A:수간중독 + 1))}
	EXP:A:20 += (((TALENT:A:동물귀 + TALENT:A:암캐)+1)*(ABL:A:Ｖ감각 + ABL:A:욕망 + ABL:A:순종 + ABL:A:성교중독 + ABL:A:정액중독 + ABL:A:수간중독 + 1))
	PRINTFORML 수간경험+{(((TALENT:A:동물귀 + TALENT:A:암캐)+1)*(ABL:A:Ｖ감각 + ABL:A:욕망 + ABL:A:순종 + ABL:A:성교중독 + ABL:A:정액중독 + ABL:A:수간중독 + (RAND:5)))}
	EXP:A:56 += (((TALENT:A:동물귀 + TALENT:A:암캐)+1)*(ABL:A:Ｖ감각 + ABL:A:욕망 + ABL:A:순종 + ABL:A:성교중독 + ABL:A:정액중독 + ABL:A:수간중독 + (RAND:5)))
	
	PRINTFORML 쾌Ｖ의 구슬+{(((TALENT:A:동물귀 + TALENT:A:암캐)+1)*(ABL:A:Ｖ감각 + RAND:10)*(ABL:A:Ｖ감각 + ABL:A:욕망 + ABL:A:순종 + ABL:A:성교중독 + ABL:A:정액중독 + ABL:A:수간중독 + RAND:10)*10)}
	JUEL:A:1 += (((TALENT:A:동물귀 + TALENT:A:암캐)+1)*(ABL:A:Ｖ감각 + RAND:10)*(ABL:A:Ｖ감각 + ABL:A:욕망 + ABL:A:순종 + ABL:A:성교중독 + ABL:A:정액중독 + ABL:A:수간중독 + RAND:10)*10)
	PRINTFORML 굴복의 구슬+{(((TALENT:A:동물귀 + TALENT:A:암캐)+1)*(ABL:A:순종 + RAND:10)*(ABL:A:Ｖ감각 + ABL:A:욕망 + ABL:A:순종 + ABL:A:성교중독 + ABL:A:정액중독 + ABL:A:수간중독 + RAND:10)*10)}
	JUEL:A:6 += (((TALENT:A:동물귀 + TALENT:A:암캐)+1)*(ABL:A:순종 + RAND:10)*(ABL:A:Ｖ감각 + ABL:A:욕망 + ABL:A:순종 + ABL:A:성교중독 + ABL:A:정액중독 + ABL:A:수간중독 + RAND:10)*10)
	PRINTFORMW 욕정의 구슬+{(((TALENT:A:동물귀 + TALENT:A:암캐)+1)*(ABL:A:욕망 + RAND:10)*(ABL:A:Ｖ감각 + ABL:A:욕망 + ABL:A:순종 + ABL:A:성교중독 + ABL:A:정액중독 + ABL:A:수간중독 + RAND:10)*10)}
	JUEL:A:5 += (((TALENT:A:동물귀 + TALENT:A:암캐)+1)*(ABL:A:욕망 + RAND:10)*(ABL:A:Ｖ감각 + ABL:A:욕망 + ABL:A:순종 + ABL:A:성교중독 + ABL:A:정액중독 + ABL:A:수간중독 + RAND:10)*10)
	
	CFLAG:A:106 += (((TALENT:A:동물귀 + TALENT:A:암캐)+1)*(ABL:A:Ｖ감각 + ABL:A:욕망 + ABL:A:순종 + ABL:A:성교중독 + ABL:A:정액중독 + ABL:A:수간중독 + 1))
	CFLAG:A:2000 += ((((TALENT:A:동물귀 + TALENT:A:암캐)+1)*(ABL:A:Ｖ감각 + ABL:A:욕망 + ABL:A:순종 + ABL:A:성교중독 + ABL:A:정액중독 + ABL:A:수간중독 + 1))*(LIMIT(RAND:10, 3, 10)))
	
ENDIF

RETURN 0


;--------------------------------------------
@ORC_MONSTER_PLAY
;--------------------------------------------

IF TALENT:MASTER:122 == 1
	PRINTW 『마왕님…』
	RETURN 0
ENDIF

X = RAND:5
IF X == 0
	PRINTW 『마…마왕님과 섹스할 수 있다니…！』
ELSEIF X == 1
	PRINTW 『감격이다…』
ELSEIF X == 2
	PRINTW 『괜찮겠습니까…나 같은 걸로？』
ELSEIF X == 3
	PRINTW 『우우…마왕님…』
ELSE
	PRINTW 『부히힛、마왕님…』
ENDIF


X = RAND:2
IF X == 0
	PRINTW 『마왕님이…내 자지를…！』
	PRINTFORMW %조사선택(SAVESTR:A, "는")% 알몸으로 오크들의 페니스에 봉사했다. 진한 정액이 %SAVESTR:A%의 입에 뿌려졌다…
	PRINTFORML 펠라경험+{Y}
	PRINTFORML 정액경험+{Y}
	EXP:A:22 += Y
	EXP:A:20 += Y
ELSEIF X == 1
	PRINTW 『모두、마왕님의 위문이다…！』
	PRINTFORMW %조사선택(SAVESTR:A, "는")% 입, 질, 항문 모든 구멍에 오크들의 페니스로 정액을 주입당했다
	PRINTW 그녀의 얼빠진 눈은, 음침한 지하감옥의 천장을 향한 채, 초점도 잡혀있지 않았다
	PRINTFORMW {Y}인분의 쌓이고 쌓인 정액으로 화장된 얼굴과 성기를 보며, 오크들은 더욱더 흥분했다
	PRINTFORML V경험+{Y}
	PRINTFORML A경험+{Y}
	PRINTFORML 펠라경험+{Y}
	PRINTFORML 정액경험+{Y}
	EXP:A:0 += Y
	EXP:A:1 += Y
	EXP:A:22 += Y
	EXP:A:20 += Y
	CFLAG:A:107 += Y
ENDIF
WAIT
RETURN 0

