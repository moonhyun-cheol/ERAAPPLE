;-----------------------------------------------
@SET_CHARA_PILLORY(ARG)
;-----------------------------------------------

PRINTL
DRAWLINE 
IF CFLAG:ARG:1 == 8
	PRINTFORMW %조사선택(SAVESTR:ARG, "를")% 풀어주시겠습니까?
	PRINTL [0]- 풀어준다
	PRINTL [1]- 그대로 둔다
	$INPUT_LOOP4
	INPUT
	IF RESULT == 0
		PRINTL
		PRINTFORMW %조사선택(SAVESTR:ARG, "를")% 흥미로운 눈으로 바라보던 당신은 
			IF TALENT:ARG:남자
				PRINT 그
			ELSE
				PRINT 그녀
			ENDIF
			PRINTW 를 풀어주라고 명했다.
		PRINTW *노출대에서 해제합니다*
		CFLAG:ARG:661 = 0
		CFLAG:ARG:662 = 0
		CFLAG:ARG:663 = 0
		CFLAG:ARG:664 = 0
		CFLAG:ARG:665 = 0
		CFLAG:ARG:1 = 0
	ELSEIF RESULT == 1
		PRINTL
		PRINTFORMW 아직 형벌을 끝내기에는 이르다고 생각한 당신은 그대로 몸을 돌렸다.
	ELSEIF RESULT < 0 || RESULT > 1
		GOTO INPUT_LOOP4
	ENDIF
ELSE
	PRINTFORMW %조사선택(SAVESTR:ARG, "는")% 노출대에 묶여있지 않습니다!
ENDIF
DRAWLINE
PRINTL
RETURN 0

;-----------------------------------------------
@SHOW_BUTTON_RETURN_CHARA(NUM, ARG)
#DIM NUM
;-----------------------------------------------

IF CFLAG:ARG:1 != 3
	SETCOLOR 0x646464
ENDIF
PRINTFORM [{NUM}] 복귀시키기 
RESETCOLOR
RETURN 0

;-----------------------------------------------
@SET_RETURN_CHARA(ARG)
;-----------------------------------------------

A = ARG

PRINTL
DRAWLINE 
IF CFLAG:ARG:1 == 3
	IF CFLAG:A:505 > 0
		IF CFLAG:(ARG:0):514 < 3
			PRINTFORML %조사선택(SAVESTR:A, "는")% 용사를 더 타락시키지 못한 채 귀환 마법으로 복귀했다……
			PRINTFORMW 다음부터는 %조사선택(SAVESTR:A, "를")% 요격 보낼 때 3일 이내에 복귀하지 않도록 하자……
		ELSE
			PRINTFORML %조사선택(SAVESTR:A, "가")% 용사들을 몇명이나 붙잡게 한 공로를 치하하기 위해 불러들이기로 결심했다.
			PRINTFORMW %조사선택(SAVESTR:A, "는")% 귀환 마법으로 복귀했다……
			CALL GOHOUBI
		ENDIF
		CFLAG:A:1 = 0
	ELSE
		IF CFLAG:(ARG:0):514 < 3
			PRINTFORML %조사선택(SAVESTR:A, "는")% 아무것도 하지 못한 채 귀환 마법으로 복귀했다……
			PRINTFORMW 다음부터는 %조사선택(SAVESTR:A, "를")% 요격 보낼 때 3일 이내에 복귀하지 않도록 하자……
		ELSE
			PRINTFORML %SAVESTR:ARG%의 모습이 못마땅하던 당신은 그녀를 돌아오게 하기로 결정했다.
			PRINTFORMW %조사선택(SAVESTR:A, "는")% 귀환 마법으로 복귀했다……
			CALL OSIOKI
		ENDIF
		CFLAG:A:1 = 0
	ENDIF
	CFLAG:A:531 = 0
	CFLAG:A:532 = 0
	CFLAG:A:533 = 0
	CFLAG:A:514 = 0
	CFLAG:A:505 = 0
ELSE
	PRINTFORMW %조사선택(SAVESTR:A, "는")% 요격중이 아닙니다!
ENDIF
DRAWLINE
PRINTL
RETURN 0

