;------------------------------------------------------------
;마계사전 반지
;------------------------------------------------------------

@MAOUDIC_RING
#DIM LINE, 1
DRAWLINE
LOCAL = 0
$PRINT_LIST
DRAWLINE
PRINTL   마계사전 반지
PRINTL 
PRINTL 《용사나 노예가 장착하는 반지를 설명합니다》
PRINTL 《위험도는 용사가 사용할 때, 효율은 노예가 사용할 때 기준입니다》
DRAWLINE
IF LOCAL == 0
	PRINTL [ 0] 장식용반지
	PRINTL [ 1] 파괴의반지
	PRINTL [ 2] 수호의반지
	PRINTL [ 3] 가속의반지
	PRINTL [ 4] 재생의반지
	PRINTL [ 5] 의사의반지
	PRINTL [ 6] 욕망의반지
	PRINTL [ 7] 괴력의반지
	PRINTL [ 8] 강인함의반지
	PRINTL [ 9] 지배의반지
	PRINTL [10] 성장의반지
	PRINTL [11] 허약함의반지
	PRINTL [12] 둔중함의반지
	PRINTL [13] 죽음의반지
	PRINTL [14] 쇠약의반지
	PRINTL [15] 세뇌의반지
	PRINTL [16] 함정회피의반지
	PRINTL [17] 침공의반지
	PRINTL [18] 결계의반지
	PRINTL [19] 시련의반지
ELSEIF LOCAL == 1
	PRINTL [20] 불행의반지
ENDIF
DRAWLINE
PRINTFORMLC \@(LOCAL <= 0) ?  %" " * 18% # [1001] 앞페이지\@
PRINTLC [1000] 돌아가기
PRINTFORMLC \@(LOCAL >= 1) ?  %" " * 18% # [1009] 다음페이지\@
$INPUT_LOOP
INPUT
IF RESULT == 1000
	RETURN 0
ELSEIF RESULT == 1001 && LOCAL > 0
	LOCAL -= 1
ELSEIF RESULT == 1009 && LOCAL < 1
	LOCAL += 1
ELSE
	TRYCCALLFORM MAOUDIC_RING_{RESULT}
	CATCH
		GOTO INPUT_LOOP
	ENDCATCH
ENDIF
GOTO PRINT_LIST

