;------------------------------------------------------------
;마계사전
;------------------------------------------------------------

@MAOUDIC
#DIM LINE, 1
LINE = LINECOUNT
$START
CLEARLINE LINECOUNT - LINE
PRINTL [0] 아이템
PRINTL [1] 함정
PRINTL [2] 반지
PRINTL [3] 시설
PRINTL [4] 특성
PRINTL [9] 돌아간다
INPUT
IF RESULT == 0
	CALL MAOUDIC_ITEM
ELSEIF RESULT == 1
	CALL MAOUDIC_TRAP
ELSEIF RESULT == 2
	CALL MAOUDIC_RING
ELSEIF RESULT == 3
	CALL MAOUDIC_ROOM
ELSEIF RESULT == 4
	CALL MAOUDIC_TALENT
ELSEIF RESULT == 9
	RETURN 0
ENDIF
GOTO START


;------------------------------------------------------------
;마계사전 아이템
;------------------------------------------------------------

@MAOUDIC_ITEM
#DIM LINE, 1
DRAWLINE
LOCAL = 0
$PRINT_LIST
DRAWLINE
PRINTL   마계사전 아이템
PRINTL 
PRINTL 《조교에 사용하는 아이템을 설명합니다》
DRAWLINE
IF LOCAL == 0
	PRINTL [ 0] 진동하는보석
	PRINTL [ 1] 꿀단지웜
	PRINTL [ 2] 진동지팡이
	PRINTL [ 3] 애널웜
	PRINTL [ 4] 페니스밴드
	PRINTL [ 5] 아이마스크
	PRINTL [ 6] 수정구
	PRINTL [ 7] 클리캡
	PRINTL [ 8] 유두캡
	PRINTL [ 9] 볼개그
	PRINTL [10] 채찍
	PRINTL [11] 바늘
	PRINTL [12] 오나홀
	PRINTL [13] 플레이매트
	PRINTL [14] 밧줄
	PRINTL [15] 관장기＋플러그
	PRINTL [16] 큰거울
	PRINTL [17] 착유기
	PRINTL [18] 개목걸이
	PRINTL [19] 에이프런
ELSEIF LOCAL == 1
	PRINTL [20] 애널비즈
	PRINTL [21] 전극플러그
	PRINTL [22] 똥개
	PRINTL [23] 본디지수트
	PRINTL [24] 콘돔
	PRINTL [25] 로션
	PRINTL [26] 미약
	PRINTL [27] 이뇨제
	PRINTL [28] 수정구의마력원
	PRINTL [29] 구충제
	PRINTL [30] 영양제
	PRINTL [31] 향
	PRINTL [33] WG배터리
	PRINTL [34] 피어스링
	PRINTL [35] 관전티켓
	PRINTL [37] 러브스코프
	PRINTL [38] 부스터메일
	PRINTL [39] 【마계지식】
ELSEIF LOCAL == 2
	PRINTL [40] 배란유발제
	PRINTL [41] 강모제
	PRINTL [42] 【조합지식】
	PRINTL [52] 【기교Lv】
	PRINTL [53] 【경험치】
ENDIF
DRAWLINE
PRINTFORMLC \@(LOCAL <= 0) ?  %" " * 18% # [1001] 앞페이지\@
PRINTLC [1000] 돌아가기
PRINTFORMLC \@(LOCAL >= 2) ?  %" " * 18% # [1009] 다음페이지\@
$INPUT_LOOP
INPUT
IF RESULT == 1000
	RETURN 0
ELSEIF RESULT == 1001 && LOCAL > 0
	LOCAL -= 1
ELSEIF RESULT == 1009 && LOCAL < 2
	LOCAL += 1
ELSE
	TRYCCALLFORM MAOUDIC_ITEM_{RESULT}
	CATCH
		GOTO INPUT_LOOP
	ENDCATCH
ENDIF
GOTO PRINT_LIST


