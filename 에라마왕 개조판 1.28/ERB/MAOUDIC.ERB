@MAOUDIC_ROOM
#DIM LINE, 1
DRAWLINE
LOCAL = 0
$PRINT_LIST
DRAWLINE
PRINTL   마계사전 시설
PRINTL 
PRINTL 《던전의 통로에 설치 가능한 시설을 설명합니다》
PRINTL 《효율은 개인적인 의견일 뿐이니 참고만 하시길》
DRAWLINE
IF LOCAL == 0
	PRINTL [ 0] 통로
	PRINTL [ 1] 상점가
	PRINTL [ 2] 습지
	PRINTL [ 3] 인간목장
	PRINTL [ 4] 얼음방
	PRINTL [ 5] 달군모래
	PRINTL [ 6] 미궁
	PRINTL [ 7] 박물관
	PRINTL [ 8] 창관거리
ENDIF
DRAWLINE
PRINTFORMLC \@(LOCAL <= 1) ?  %" " * 18% # [1001] 앞페이지\@
PRINTLC [1000] 돌아가기
PRINTFORMLC \@(LOCAL >= 0) ?  %" " * 18% # [1009] 다음페이지\@
$INPUT_LOOP
INPUT
IF RESULT == 1000
	RETURN 0
ELSEIF RESULT == 1001 && LOCAL > 1
	LOCAL -= 1
ELSEIF RESULT == 1009 && LOCAL < 0
	LOCAL += 1
ELSE
	TRYCCALLFORM MAOUDIC_ROOM_{RESULT}
	CATCH
		GOTO INPUT_LOOP
	ENDCATCH
ENDIF
GOTO PRINT_LIST


