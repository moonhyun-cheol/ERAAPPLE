@ENTER_LOVER, ARG:0
;------------------------------------
;ARG:0 = 対象勇者

SIF ARG:0 < 0
	RETURN 0

PRINTFORML 마왕의 부하를 도시에 파견하여 용사를 사랑의 함정에 떨어뜨립니다.
PRINTFORML %SAVESTR:(ARG:0)%에게 접근시키는 부하를 선택하십시오.

PRINTL [0] 파견하지 않는다.

FOR LOCAL, 1, 100
	CALL NAME_LOVER,LOCAL,0
	IF RESULT == 1
		PRINTFORM [{LOCAL}] 
		CALL NAME_LOVER,LOCAL,1
		PRINT 　
	ENDIF
	
	LOCAL:1 = LOCAL % 20
	SIF LOCAL:1 == 0
		PRINTL  
NEXT
PRINTL [999] 돌아온다
DRAWLINE

;入力
$INPUT_LOOP
INPUT

;돌아온다
IF RESULT == 999
	RETURN 0
ELSEIF RESULT == 0
	LOCAL = 0
ELSE
	LOCAL = RESULT
	;対象が存在しているか判定する
	CALL NAME_LOVER,LOCAL,0
	SIF RESULT == 0
		GOTO INPUT_LOOP
ENDIF

;恋人派遣確定

LOCAL:1 = CFLAG:(ARG:0):606
CFLAG:(ARG:0):606 = LOCAL

;愛情度リセット
SIF LOCAL != LOCAL:1
	CFLAG:(ARG:0):607 = 0

IF LOCAL > 0
	PRINTFORM %SAVESTR:(ARG:0)%에게 부하인 
	CALL NAME_LOVER,LOCAL,1
	PRINTW 를 접근 시켰습니다
ELSE
	PRINTFORMW 아무도 %SAVESTR:(ARG:0)%에게는 접근하지 않았습니다
ENDIF

RETURN 1

