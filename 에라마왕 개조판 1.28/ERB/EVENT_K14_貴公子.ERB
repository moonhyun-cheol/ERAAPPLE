;--------------------------------------------------
;口上ファイルの存在判定（X2をキャラ番号に置換）
;--------------------------------------------------
@EVENTTRAIN
#PRI
FLAG:114 = 1
SIF FLAG:7 == 0
	FLAG:7 = 2

@EVENTEND
#LATER
FLAG:114 = 0

