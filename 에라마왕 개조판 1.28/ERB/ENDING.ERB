;---------------------------------------------------------
@CHAR_GIFT, ARG, ARGS
#DIM CHARA, 1
#DIM PERSONAL
#DIM MOTHER
#DIM MON_ID
#DIM MOTHER_TYPE
#DIM MOTHER_RACE
;---------------------------------------------------------
;ARG = 指定種族（100以上は指定母体）
;ARGS = 贈呈元

;母親フラグ
MOTHER = -1
MOTHER_RACE = -1
MON_ID = 0
MOTHER_TYPE = 0
PERSONAL = 160

IF ARG > 100
	MOTHER = ARG - 100
	ARG = 9
	MON_ID = CFLAG:MOTHER:112
	IF MON_ID == 171
		;듀라한
		ARG = 4
	ELSEIF MON_ID == 172
		;ヴァンパイアは吸血鬼
		ARG = 3
	ELSEIF MON_ID == 114 || MON_ID == 141
		;좀비하운드・ヘルハウンドは人狼
		ARG = 2
	ELSEIF MON_ID == 193
		;カオスドラゴンはドラゴン
		ARG = 5
	ELSEIF MON_ID == 191
		;ダークメサイアは타천사
		ARG = 8
	ENDIF
	
	;母親の性格記憶
	FOR LOCAL,160,199
		IF TALENT:MOTHER:LOCAL == 1
			;モンスターIDと区別するため, 1000を追加する
			MOTHER_TYPE = LOCAL + 1000
			BREAK
		ENDIF
	NEXT
	
	MOTHER_RACE = TALENT:MOTHER:314
	
ENDIF

;キャラのNOを選定
$INPUT_LOOP_1
CHARA = RAND(1, 17)
;出産の場合, 特殊キャラ呼び出し
SIF MOTHER >= 0
	CHARA = 100
ADDCHARA CHARA
A = CHARANUM - 1

TALENT:A:300 = LOCAL:300
SIF TALENT:A:300 == 0
	TALENT:A:300 = 1

$INPUT_LOOP_2
PRINTL 취향의 성격과 머리카락색을 설정해 주세요. 
PRINTFORML [0] 성격 ： %TALENTNAME:PERSONAL%
PRINT [1] 머리 색깔 ： 

IF TALENT:A:300 == 1
	PRINTL 금발
ELSEIF TALENT:A:300 == 2
	PRINTL 갈색
ELSEIF TALENT:A:300 == 3
	PRINTL 흑발
ELSEIF TALENT:A:300 == 4
	PRINTL 적발
ELSEIF TALENT:A:300 == 5
	PRINTL 은발
ELSEIF TALENT:A:300 == 6
	PRINTL 청발
ELSEIF TALENT:A:300 == 7
	PRINTL 녹발
ENDIF

DRAWLINE
PRINTL [100] 결정

INPUT

IF RESULT == 0
	PRINTL 취향의 성격을 선택해 주세요. 
	PRINTL [0] - 자애로움　　[1] - 자신만만　[2] - 기가약함　　
	PRINTL [3] - 고귀함　	　[4] - 냉철함　　[5] - 악녀　　
	PRINTL [6] - 두뇌명석　　[7] - 비호자　
	INPUT
	IF RESULT >= 8
		PERSONAL = 160
		GOTO INPUT_LOOP_2
